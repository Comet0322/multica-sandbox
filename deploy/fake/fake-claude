#!/bin/sh
# Stand-in for Claude Code for credential-free trials of the sandbox runtime. It speaks just
# enough stream-json for the daemon and proves the agent can reach the Multica
# API with its task token through the manager. SANDBOX_FAKE_NOTE, set in the
# agent's custom environment, is echoed in the comment to show that the
# environment reached the agent. SANDBOX_FAKE_SLEEP (seconds) keeps the task
# running that long after the comment, so a trial can fill the pool.
# SANDBOX_FAKE_MEMORY (MiB) makes the task hold that much memory for a few
# seconds, so a trial can run a pod out of memory. SANDBOX_FAKE_BRANCH names a
# git branch the agent looks for in a repository under the pod's bare repo
# cache (MULTICA_WORKSPACES_ROOT/.repos): found, it says so; not found, it
# commits to a new branch of that name and never pushes it, as an agent that
# hands its work to the next one on the same pod would.
case "${1:-}" in
--version | -v)
	echo "2.1.0 (Claude Code)"
	exit 0
	;;
esac
prompt="$(head -n 1)"
# Count the files an earlier task on this pod left (a new pod has none), then leave
# one in the task directory, the caches under HOME, Claude Code's own state
# next to the image skills (~/.claude/projects), TMPDIR and /tmp, for the next
# task to look for.
left="$(find "$HOME" -name 'sandbox-fake-left-*' 2>/dev/null | wc -l)"
mkdir -p "$HOME/.cache/sandbox-fake" "$HOME/.claude/projects/sandbox-fake"
for d in . "$HOME/.cache/sandbox-fake" "$HOME/.claude/projects/sandbox-fake" "${TMPDIR:-/tmp}" /tmp; do
	echo "$$" >"$d/sandbox-fake-left-$$" 2>/dev/null || true
done
issue="$(printf '%s' "$prompt" | grep -oE 'assigned issue ID is: [0-9a-f-]{36}' | head -n 1 | sed 's/.* //')"
# A task a comment started must reply under that comment.
parent="$(printf '%s' "$prompt" | grep -oE -- '--parent [0-9a-f-]{36}' | head -n 1 | sed 's/.* //')"
branch=""
if [ -n "${SANDBOX_FAKE_BRANCH:-}" ]; then
	repo="${MULTICA_WORKSPACES_ROOT:-$HOME/multica_workspaces}/.repos/sandbox-fake"
	if sha="$(git -C "$repo" rev-parse --short --verify -q "refs/heads/$SANDBOX_FAKE_BRANCH" 2>/dev/null)"; then
		branch=", branch $SANDBOX_FAKE_BRANCH found at $sha"
	elif mkdir -p "$repo" && git -C "$repo" init -q 2>/dev/null &&
		git -C "$repo" checkout -q -B "$SANDBOX_FAKE_BRANCH" &&
		git -C "$repo" commit -q --allow-empty -m "unpushed work of task $$" &&
		sha="$(git -C "$repo" rev-parse --short HEAD)"; then
		branch=", branch $SANDBOX_FAKE_BRANCH created at $sha, not pushed"
	else
		branch=", branch $SANDBOX_FAKE_BRANCH could not be created"
	fi
fi
note="no issue ID in prompt"
if [ -n "$issue" ]; then
	if multica issue comment add "$issue" ${parent:+--parent "$parent"} --content "sandbox-fake: agent ran in $(hostname) with skill $(ls "$HOME/.claude/skills" 2>/dev/null | tr '\n' ' ')earlier task files $left, note ${SANDBOX_FAKE_NOTE:-unset}$branch">/tmp/comment.log 2>&1; then
		note="commented on $issue"
	else
		note="comment failed: $(tail -n 1 /tmp/comment.log)"
	fi
fi
case "${SANDBOX_FAKE_SLEEP:-}" in '' | *[!0-9]*) ;; *) sleep "$SANDBOX_FAKE_SLEEP" ;; esac
case "${SANDBOX_FAKE_MEMORY:-}" in '' | *[!0-9]*) ;; *)
	python3 -c 'import sys, time; b = bytearray(int(sys.argv[1]) << 20); b[::4096] = b"x" * len(b[::4096]); time.sleep(5)' "$SANDBOX_FAKE_MEMORY" ;;
esac
sid="sandbox-fake-$$"
printf '{"type":"system","subtype":"init","session_id":"%s"}\n' "$sid"
printf '{"type":"result","subtype":"success","is_error":false,"result":"sandbox-fake done: %s","session_id":"%s"}\n' "$note" "$sid"
